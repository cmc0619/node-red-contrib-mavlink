# ArduCopter SITL for the node-red-contrib-mavlink lab.
# Uses the official prebuilt static binary (same Copter-4.7.0 line DESIGN.md pins),
# not a from-source waf build — ~7 MB download vs tens of minutes compiling.
#
# Build: docker build -f sitl/Dockerfile.ardupilot -t nrc-mavlink-ap-sitl:local sitl/

FROM ubuntu:22.04

ARG ARDUPILOT_SITL_URL=https://firmware.ardupilot.org/Copter/stable-4.7.0/SITL_x86_64_linux_gnu/arducopter
ARG ARDUPILOT_REF=Copter-4.7.0
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    USER=sitl \
    ARDUPILOT_REF=${ARDUPILOT_REF} \
    ARDUPILOT_SITL_URL=${ARDUPILOT_SITL_URL}

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
 && echo "$TZ" > /etc/timezone \
 && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /usr/local/bin/arducopter "${ARDUPILOT_SITL_URL}" \
 && chmod 0755 /usr/local/bin/arducopter \
 && /usr/local/bin/arducopter --help >/dev/null

RUN useradd -m -s /bin/bash sitl \
 && mkdir -p /home/sitl/aircraft /logs /params \
 && chown -R sitl:sitl /home/sitl /logs /params

COPY scripts/entrypoint-ap.sh /usr/local/bin/entrypoint-ap.sh
COPY scripts/resolve-out-host.sh /usr/local/bin/resolve-out-host.sh
COPY params/ap-logging.parm /params/ap-logging.parm
RUN chmod +x /usr/local/bin/entrypoint-ap.sh /usr/local/bin/resolve-out-host.sh

USER sitl
WORKDIR /home/sitl/aircraft
VOLUME ["/logs"]
ENTRYPOINT ["/usr/local/bin/entrypoint-ap.sh"]
