# Optional convenience image. The Compose lab uses `px4io/px4-sitl:latest` directly
# with `scripts/entrypoint-px4.sh` mounted — prefer that path.
# This Dockerfile remains for operators who want a pre-baked wrapper tag.
ARG PX4_SITL_IMAGE=px4io/px4-sitl:latest
FROM ${PX4_SITL_IMAGE}

USER root
COPY scripts/entrypoint-px4.sh /usr/local/bin/entrypoint-px4.sh
COPY params/px4-logging.env /params/px4-logging.env
RUN chmod +x /usr/local/bin/entrypoint-px4.sh \
 && mkdir -p /logs \
 && chmod 777 /logs

ENV PX4_SIM_MODEL=sihsim_quadx \
    HEADLESS=1

VOLUME ["/logs"]
ENTRYPOINT ["/bin/bash", "/usr/local/bin/entrypoint-px4.sh"]
