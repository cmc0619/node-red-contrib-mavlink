{
  "name": "@cmc0619/node-red-contrib-mavlink",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "MAVLink toolkit for Node-RED — GCS and companion roles, one node set.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmc0619/node-red-contrib-mavlink.git"
  },
  "homepage": "https://github.com/cmc0619/node-red-contrib-mavlink#readme",
  "bugs": {
    "url": "https://github.com/cmc0619/node-red-contrib-mavlink/issues"
  },
  "author": "cmc0619",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm test",
    "lint": "npm run test:lint-config && eslint . --max-warnings=0",
    "test": "node --test lib/**/test/*.test.js test/**/*.test.js",
    "test:lint-config": "node --test test/tooling/lint-coverage.check.js",
    "test:runtime": "node --test integration/node-red-smoke.test.js",
    "validate:node-red": "npm exec --yes --package=node-red-dev@0.1.6 -- node-red-dev validate",
    "generate-seed": "node scripts/generate-seed.js",
    "generate-param-seed": "node scripts/generate-param-seed.js"
  },
  "files": [
    "lib",
    "!lib/**/test/**",
    "nodes",
    "resources",
    "examples",
    "seed",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "node-mavlink": "^2.3.0"
  },
  "overrides": {
    "jsonata": "^2.2.2",
    "xml2js": "^0.6.2"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0",
    "sockopt": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.8.0",
    "node-red": "^5.0.4",
    "node-red-node-test-helper": "^0.3.6"
  },
  "keywords": [
    "node-red",
    "mavlink",
    "ardupilot",
    "px4",
    "drone"
  ],
  "node-red": {
    "version": ">=4.0.0",
    "//": "mavlink-local-identity MUST stay first. It is the only node HTML that loads resources/mavlink-editor.js, and Node-RED appends node HTML one node at a time (a marker per node set, walked sequentially), so any node listed ahead of it runs registerType before RED.mavlink exists. Measured on Node-RED 5.0.1: moving it last leaves 2 of 10 palette nodes registered, with a TypeError on RED.mavlink.validateUint8. Enforced by the first-key assertion in test/nodes/editor-load-order.test.js.",
    "nodes": {
      "mavlink-local-identity": "nodes/mavlink-local-identity.js",
      "mavlink-vehicle": "nodes/mavlink-vehicle.js",
      "mavlink-connection": "nodes/mavlink-connection.js",
      "mavlink-in": "nodes/mavlink-in.js",
      "mavlink-out": "nodes/mavlink-out.js",
      "mavlink-build": "nodes/mavlink-build.js",
      "mavlink-command": "nodes/mavlink-command.js",
      "mavlink-move": "nodes/mavlink-move.js",
      "mavlink-param": "nodes/mavlink-param.js",
      "mavlink-payload": "nodes/mavlink-payload.js",
      "mavlink-state": "nodes/mavlink-state.js",
      "mavlink-mission": "nodes/mavlink-mission.js",
      "mavlink-fanout": "nodes/mavlink-fanout.js",
      "mavlink-formation": "nodes/mavlink-formation.js"
    }
  }
}
