  {
    "id": "ex11-fn-ring",
    "type": "function",
    "z": "ex11-tab",
    "name": "Ring points",
    "func": "// Ring setpoint generator \u2014 no arc primitive; the ring is flow-author maths.\n// The Move node's action (goto) and altitude reference (above home) live in\n// its config; the payload carries only the coordinates.\nconst R = 100;\nconst alt = 20;\nconst c_lat = -35.363261;\nconst c_lon = 149.165230;\nlet theta = context.get('theta') || 0;\ntheta += Math.PI / 18;\ncontext.set('theta', theta);\nconst lat = c_lat + (R * Math.sin(theta)) / 111320;\nconst lon = c_lon + (R * Math.cos(theta)) / (111320 * Math.cos(c_lat * Math.PI / 180));\nmsg.payload = {\n    position: { lat, lon, alt }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 220,
    "wires": [
      [
        "ex11-move-circle"
      ]
    ]
  },
