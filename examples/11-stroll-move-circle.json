    "action": "goto",
    "altRef": "home",
    "targetSystem": 1,
    "targetComponent": 1,
    "north": "",
    "east": "",
    "up": "",
    "vNorth": "",
    "vEast": "",
    "vUp": "",
    "lat": -35.363261,
    "lon": 149.16523,
    "alt": 20,
    "yaw": "",
    "yawRate": "",
    "rateHz": 5,
    "ttlMs": 1500,
    "x": 660,
    "y": 220,
    "wires": [
