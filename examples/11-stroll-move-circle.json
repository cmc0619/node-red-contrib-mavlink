  {
    "id": "ex11-fn-ring",
    "type": "function",
    "z": "ex11-tab",
    "name": "Ring points",
    "func": "// Ring setpoint generator — no arc primitive; the ring is flow-author maths.\n// The Move node's action (goto) and altitude reference (above home) live in\n// its config; the payload carries only the coordinates.\n//\n// The gate matters as much as the maths. A 0.2 s inject drives this whether\n// or not anyone asked to fly, so the flag is what makes the buttons real:\n// Fly circle sets it, Stop clears it and sends the stop, and every tick in\n// between returns null so the stream's TTL (1500 ms) lets the setpoint lapse.\n// Nothing on this repeating path may set the flag — doing so overwrote Stop\n// within 200 ms and the circle never ended.\nif (flow.get('circling') !== true) { return null; }\nconst R = 100;\nconst alt = 20;\nconst c_lat = -35.363261;\nconst c_lon = 149.165230;\nlet theta = context.get('theta') || 0;\ntheta += Math.PI / 18;\ncontext.set('theta', theta);\nconst lat = c_lat + (R * Math.sin(theta)) / 111320;\nconst lon = c_lon + (R * Math.cos(theta)) / (111320 * Math.cos(c_lat * Math.PI / 180));\nmsg.payload = {\n    position: { lat, lon, alt }\n};\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 220,
    "wires": [
      [
        "ex11-move-circle"
      ]
    ]
  },
