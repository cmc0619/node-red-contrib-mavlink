    "id": "ex11-tab",
    "type": "tab",
    "label": "11 Streamed circle (Move)",
    "disabled": false,
    "info": "Same joyride idea but the circle is flown by streaming SET_POSITION_TARGET_GLOBAL_INT setpoints from a Function node. Contrast with DO_ORBIT in example 10. Move TTL self-stops when injects cease.",
