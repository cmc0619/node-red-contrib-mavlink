  {
    "id": "ex22-comment",
    "type": "comment",
    "z": "ex22-tab",
    "name": "Go-to tour (Move goto)",
    "info": "Each hop is a mavlink-move node: action Go to, delivery Send & confirm — DO_REPOSITION on the COMMAND_INT carrier under the hood. A blank Yaw encodes the NaN sentinel (hold current heading) and a blank Loiter radius encodes 0 (ignored); Ground speed is 5 m/s. Bind 14550→14551.",
    "x": 180,
    "y": 40,
    "wires": []
  },
