[
  {
    "id": "ex12-tab",
    "type": "tab",
    "label": "12 Ebony & Ivory",
    "disabled": false,
    "info": "Dual-stack demo: ArduPilot (Ebony, sysid 1) and PX4 (Ivory, sysid 11) on separate connections sharing one GCS identity.",
    "env": []
  },
  {
    "id": "ex12-comment",
    "type": "comment",
    "z": "ex12-tab",
    "name": "Ebony & Ivory dual stack",
    "info": "ArduPilot: bind 127.0.0.1:14550 → remote 14551 (sysid 1). PX4: bind 14560 → remote 14561 (sysid 11) — PX4 SITL ports are version-specific; verify against your build (commonly 14550/14570/14580). Do NOT reuse ArduPilot custom_mode numbers on PX4; Ivory uses takeoff without hardcoded GUIDED. Launch: sim_vehicle.py -v ArduCopter --out=udp:127.0.0.1:14551 and PX4 SITL with MAV_SYS_ID=11.",
    "x": 200,
    "y": 40,
    "wires": []
  },
  {
    "id": "ex12-identity",
    "type": "mavlink-local-identity",
    "name": "GCS identity",
    "role": "gcs",
    "sourceSystemId": 255,
    "sourceComponentId": 190,
    "heartbeatType": "MAV_TYPE_GCS",
    "heartbeatAutopilot": "MAV_AUTOPILOT_INVALID"
  },
