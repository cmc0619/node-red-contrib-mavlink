  {
    "id": "sitl42-fn-watchdog",
    "type": "function",
    "z": "sitl42-tab",
    "name": "leader lost = hold, back = resume",
    "func": "// Watchdog: a stale/expired leader holds the loop (followers keep their\n// last commanded positions — hold-on-loss; no successor promotion in flow\n// form). A fresh heartbeat (or re-added peer) from the leader auto-resumes\n// and re-seeds the gate baseline on the next position update.\n// Keep LEADER in sync with the In node's sysid filter and Formation's leader.\nconst LEADER = 1;\nconst state = flow.get('followLeader') || { halted: true, last: null };\nconst rec = msg.payload || {};\n\nif (Number(rec.sysid) !== LEADER) return null;\n\nif (rec.event === 'stale' || rec.event === 'expired') {\n  state.halted = true;\n  flow.set('followLeader', state);\n  node.status({ fill: 'red', shape: 'ring', text: `leader ${rec.event} — following held` });\n  return { payload: { held: true, reason: rec.event, leader: LEADER, at: rec.at } };\n}\n\nif ((rec.event === 'heartbeat' || rec.event === 'peer-new') && state.halted) {\n  state.halted = false;\n  state.last = null;\n  flow.set('followLeader', state);\n  node.status({ fill: 'green', shape: 'dot', text: 'leader back — resuming' });\n  return { payload: { held: false, resumed: true, leader: LEADER, at: rec.at } };\n}\n\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 540,
    "wires": [
      [
        "sitl42-watchdog-events"
      ]
    ]
