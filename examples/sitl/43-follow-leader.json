  {
    "id": "sitl42-fn-gate",
    "type": "function",
    "z": "sitl42-tab",
    "name": "minMove gate + hold check",
    "func": "// The 1 Hz update gate lives upstream (In node rateLimit). This is the\n// minMove jitter gate plus the leader-loss hold: pass an update only when\n// the leader moved at least MIN_MOVE_M (horizontal) since the last accepted\n// fix, and hold everything while the watchdog has the leader flagged lost.\n// The first fix seeds the baseline WITHOUT firing — a re-anchor is triggered\n// by leader movement, never by the stream starting.\nconst MIN_MOVE_M = 15;\nconst state = flow.get('followLeader') || { halted: true, last: null };\n\nif (state.halted) {\n  node.status({ fill: 'yellow', shape: 'ring', text: 'held — leader link not confirmed' });\n  return null;\n}\n\n// GLOBAL_POSITION_INT wire units: lat/lon are degE7 integers.\nconst pos = { lat: Number(msg.payload.lat) / 1e7, lon: Number(msg.payload.lon) / 1e7 };\n\nif (!state.last) {\n  state.last = pos;\n  flow.set('followLeader', state);\n  node.status({ fill: 'grey', shape: 'dot', text: 'baseline seeded — waiting for movement' });\n  return null;\n}\n\nconst toRad = (d) => d * Math.PI / 180;\nconst x = toRad(pos.lon - state.last.lon) * Math.cos(toRad((pos.lat + state.last.lat) / 2));\nconst y = toRad(pos.lat - state.last.lat);\nconst moved = Math.sqrt(x * x + y * y) * 6371000; // equirectangular, fine at formation scale\nif (moved < MIN_MOVE_M) {\n  node.status({ fill: 'grey', shape: 'dot', text: `moved ${moved.toFixed(1)} m < ${MIN_MOVE_M} m — holding` });\n  return null;\n}\n\nstate.last = pos;\nflow.set('followLeader', state);\nnode.status({ fill: 'green', shape: 'dot', text: `leader moved ${moved.toFixed(1)} m — re-anchoring` });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 420,
    "wires": [
      [
        "sitl42-reanchor"
      ]
    ]
  },
