  {
    "id": "sitl30-list",
    "type": "mavlink-param",
    "z": "sitl30-tab",
    "name": "Collect all params",
    "connection": "sitl30-connection",
    "delivery": "collect",
    "action": "request-list",
    "firmware": "px4",
    "targetSystem": 11,
    "targetComponent": 1,
    "lookup": "name",
    "paramId": "",
    "paramIndex": -1,
    "value": "",
