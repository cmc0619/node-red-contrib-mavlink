    "timeout": "45000",
    "identity": "",
    "dialect": "",
    "vehicle": "",
    "x": 400,
    "y": 160,
    "wires": [
      [
        "sitl30-assert"
      ],
      [
        "sitl30-list-status"
      ]
    ]
  },
  {
    "id": "sitl30-assert",
    "type": "function",
    "z": "sitl30-tab",
    "name": "Assert known PX4 ids",
    "func": "const list = Array.isArray(msg.payload) ? msg.payload : [];\nconst ids = new Set(list.map((p) => p && p.paramId).filter(Boolean));\nconst hasRc = ids.has('COM_RC_IN_MODE');\nconst hasVel = ids.has('MPC_XY_VEL_MAX');\nconst ok = list.length > 0 && hasRc && hasVel;\nmsg.payload = {\n  result: ok ? 'succeeded' : 'failed',\n  detail: ok\n    ? ('px4-list count=' + list.length)\n    : ('px4-list incomplete count=' + list.length + ' rc=' + hasRc + ' vel=' + hasVel),\n  count: list.length\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 660,
    "y": 140,
    "wires": [
      [
        "sitl30-list-assert"
      ]
    ]
  },
