  {
    "id": "sitl28-list",
    "type": "mavlink-param",
    "z": "sitl28-tab",
    "name": "Collect all params",
    "connection": "sitl28-connection",
    "delivery": "collect",
    "action": "request-list",
    "firmware": "ardupilot",
    "targetSystem": 1,
    "targetComponent": 1,
    "lookup": "name",
    "paramId": "",
    "paramIndex": -1,
    "value": "",
    "paramType": "MAV_PARAM_TYPE_REAL32",
    "timeout": "30000",
    "x": 420,
    "y": 160,
    "wires": [
      [
        "sitl28-pick-index"
      ],
      [
        "sitl28-list-status"
      ]
    ]
  },
  {
    "id": "sitl28-pick-index",
    "type": "function",
    "z": "sitl28-tab",
    "name": "Pick LOIT_SPEED_MS index",
    "func": "const list = Array.isArray(msg.payload) ? msg.payload : [];\nconst hit = list.find((p) => p && p.paramId === 'LOIT_SPEED_MS');\nif (!hit || !Number.isInteger(hit.index) || hit.index < 0) {\n  node.error('LOIT_SPEED_MS missing from collected list', msg);\n  return null;\n}\nmsg.payload = {\n  action: 'read',\n  paramIndex: hit.index,\n  paramId: ''\n};\nmsg._pickedIndex = hit.index;\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 140,
    "wires": [
      [
        "sitl28-read"
      ]
    ]
  },
  {
    "id": "sitl28-read",
    "type": "mavlink-param",
    "z": "sitl28-tab",
    "name": "Read by index",
    "connection": "sitl28-connection",
    "delivery": "send",
    "action": "read",
    "firmware": "ardupilot",
    "targetSystem": 1,
    "targetComponent": 1,
    "lookup": "index",
    "paramId": "",
    "paramIndex": 0,
    "value": "",
    "paramType": "MAV_PARAM_TYPE_REAL32",
    "x": 900,
    "y": 140,
    "wires": [
      [
        "sitl28-assert"
      ],
      [
        "sitl28-read-status"
      ]
    ]
  },
  {
    "id": "sitl28-assert",
    "type": "function",
    "z": "sitl28-tab",
    "name": "Assert index wire shape",
    "func": "const m = msg.payload;\nconst fields = m && m.fields ? m.fields : {};\nconst idx = Number(fields.param_index);\nconst id = fields.param_id == null ? '' : String(fields.param_id).replace(/\\0/g, '').trim();\nconst ok = m && m.name === 'PARAM_REQUEST_READ' && Number.isInteger(idx) && idx >= 0 && id === '';\nmsg.payload = {\n  result: ok ? 'succeeded' : 'failed',\n  detail: ok\n    ? ('index-read param_index=' + idx)\n    : ('index-read wire shape wrong name=' + (m && m.name) + ' index=' + fields.param_index + ' id=' + JSON.stringify(fields.param_id)),\n  pickedIndex: msg._pickedIndex,\n  message: m\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1120,
    "y": 120,
    "wires": [
      [
        "sitl28-index-assert"
      ]
    ]
  },
