[
  {
    "id": "sitl16-tab",
    "type": "tab",
    "label": "SITL 06 Companion PX4",
    "disabled": false,
    "info": "Node-RED as onboard companion sharing vehicle sysid 21, compid 191. Lab ports bind 14542→14543.",
    "env": []
  },
  {
    "id": "sitl16-comment",
    "type": "comment",
    "z": "sitl16-tab",
    "name": "Companion SITL",
    "info": "Companion role: MAV_TYPE_ONBOARD_CONTROLLER. Shares sysid 21 with the SITL vehicle; peer table shows two components. Bind 14542→14543. Prefer Docker lab: see sitl/README.md.",
