    "sourceSystemId": 21,
    "sourceComponentId": 191,
    "heartbeatType": "MAV_TYPE_ONBOARD_CONTROLLER",
    "heartbeatAutopilot": "MAV_AUTOPILOT_INVALID"
  },
  {
    "id": "sitl16-vehicle",
    "type": "mavlink-vehicle",
    "name": "Vehicle profile",
    "vehicleFamily": "copter",
    "firmware": "px4",
    "dialect": "common",
    "defaultTargetSystem": 21,
    "defaultTargetComponent": 1,
    "paramDefsUrl": "",
    "dialectRevision": "seed"
  },
  {
    "id": "sitl16-connection",
    "type": "mavlink-connection",
    "name": "UDP companion 21",
    "mode": "udp",
    "bindHost": "0.0.0.0",
    "bindPort": 14542,
    "remoteHost": "127.0.0.1",
    "remotePort": 14543,
    "vehicle": "sitl16-vehicle",
    "localIdentity": "sitl16-identity",
    "additionalIdentities": [],
    "signOutbound": false,
    "requireSigned": false,
    "acceptInvalid": false,
    "linkId": 0,
    "staleMs": "",
    "expireMs": "",
    "disabled": false
  },
  {
    "id": "sitl16-inject-nvf",
    "type": "inject",
    "z": "sitl16-tab",
    "name": "Send one NVF now",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 160,
    "wires": [
      [
        "sitl16-build-nvf"
      ]
    ]
  },
  {
    "id": "sitl16-build-nvf",
    "type": "mavlink-build",
    "z": "sitl16-tab",
    "name": "Metric NVF (send)",
    "vehicle": "sitl16-vehicle",
    "connection": "sitl16-connection",
    "messageName": "NAMED_VALUE_FLOAT",
    "fields": "{\"time_boot_ms\":0,\"name\":\"metric\",\"value\":42}",
    "tier": "send",
    "band": "2",
    "repeatMs": 1000,
    "x": 360,
