  {
    "id": "sitl41-walk",
    "type": "function",
    "z": "sitl41-tab",
    "name": "walk remaining mode indices",
    "func": "// Copter-4.7.0 answers one AVAILABLE_MODES frame per request (measured\n// 2026-08-18); PX4 bursts the full list unasked. Read number_modes from the\n// first reply and request every other index once — never again after that.\nif (context.get('walked')) return null;\ncontext.set('walked', true);\nconst total = Number(msg.payload.number_modes);\nconst got = Number(msg.payload.mode_index);\nconst out = [];\nfor (let i = 1; i <= total; i++) {\n  if (i === got) continue;\n  out.push({ payload: { 1: 435, 2: i } });\n}\nreturn [out];",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 220,
    "wires": [
      [
        "sitl41-request-walk"
      ]
    ]
  },
