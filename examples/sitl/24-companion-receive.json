[
  {
    "id": "sitl24-tab",
    "type": "tab",
    "label": "SITL 24 Companion receive",
    "disabled": false,
    "info": "Node-RED as an onboard companion for ArduPilot sysid 20 on the companion UDP pair. Receives HEARTBEAT and STATUSTEXT from the vehicle and can send one NAMED_VALUE_FLOAT.",
    "env": []
  },
  {
    "id": "sitl24-comment",
    "type": "comment",
    "z": "sitl24-tab",
    "name": "Companion receive from AP sysid 20",
    "info": "Companion role: MAV_TYPE_ONBOARD_CONTROLLER. Shares the vehicle sysid 20 and uses compid 191. Connection binds 0.0.0.0:14540 and sends to 127.0.0.1:14541.\n\nThe receive proof is HEARTBEAT and STATUSTEXT filtered to sysid 20 / compid 1. The optional inject sends one NAMED_VALUE_FLOAT as the companion.",
    "x": 250,
    "y": 40,
    "wires": []
  },
  {
    "id": "sitl24-identity",
    "type": "mavlink-local-identity",
    "name": "Companion identity",
    "role": "companion",
    "sourceSystemId": 20,
    "sourceComponentId": 191,
    "heartbeatType": "MAV_TYPE_ONBOARD_CONTROLLER",
    "heartbeatAutopilot": "MAV_AUTOPILOT_INVALID"
  },
  {
    "id": "sitl24-vehicle",
    "type": "mavlink-vehicle",
    "name": "ArduCopter companion sysid 20",
    "vehicleFamily": "copter",
    "firmware": "ardupilot",
    "dialect": "ardupilotmega",
    "dialectSource": "bundled",
    "defaultTargetSystem": 20,
    "defaultTargetComponent": 1,
    "paramDefsUrl": ""
  },
  {
    "id": "sitl24-connection",
    "type": "mavlink-connection",
    "name": "UDP companion 20",
    "mode": "udp",
    "bindHost": "0.0.0.0",
    "bindPort": 14540,
    "remoteHost": "127.0.0.1",
    "remotePort": 14541,
    "broadcast": false,
    "vehicle": "sitl24-vehicle",
    "localIdentity": "sitl24-identity",
    "additionalIdentities": [],
    "signOutbound": false,
    "requireSigned": false,
    "acceptInvalid": false,
    "linkId": 0,
    "heartbeatInterval": 1000,
    "staleMs": "",
    "expireMs": "",
    "disabled": false
  },
  {
    "id": "sitl24-inject-nvf",
    "type": "inject",
    "z": "sitl24-tab",
    "name": "Send companion NVF",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 160,
    "wires": [
      [
        "sitl24-build-nvf"
      ]
    ]
  },
  {
    "id": "sitl24-build-nvf",
    "type": "mavlink-build",
    "z": "sitl24-tab",
    "name": "Companion NVF (send)",
    "vehicle": "sitl24-vehicle",
    "connection": "sitl24-connection",
    "messageName": "NAMED_VALUE_FLOAT",
    "fields": "{\"time_boot_ms\":0,\"name\":\"companion\",\"value\":24}",
    "tier": "send",
    "band": "2",
    "repeatMs": 1000,
    "x": 390,
    "y": 160,
    "wires": [
      [
        "sitl24-debug-nvf"
      ],
      [
        "sitl24-debug-nvf-status"
      ]
    ]
  },
  {
