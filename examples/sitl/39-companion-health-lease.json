[
  {
    "id": "sitl39-tab",
    "type": "tab",
    "label": "SITL 39 Health Lease",
    "disabled": false,
    "info": "Companion health assertion with a 5 s TTL lease on sysid 20, compid 191. Assert ok arms/renews the lease and the companion HEARTBEAT rides; silence past the TTL or an explicit fatal faults the identity and the HEARTBEAT stops — the vehicle's companion-loss behavior is the point. Lab ports bind 14540→14541.",
    "env": []
  },
  {
    "id": "sitl39-comment",
    "type": "comment",
    "z": "sitl39-tab",
    "name": "Companion health lease",
    "info": "mavlink-health asserts the companion identity's health on the Connection. {health:'ok'} clears any fault and opens (or renews) the 5 s lease — keep sending ok before it lapses, or the identity faults on its own and its HEARTBEAT stops. {health:'fatal'} faults immediately and cancels the pending lease; a later ok resumes. Watch the debug outputs: status carries healthy / faulted / lease-expired records. Prefer Docker lab: see sitl/README.md.",
    "x": 220,
    "y": 40,
    "wires": []
  },
  {
    "id": "sitl39-identity",
    "type": "mavlink-local-identity",
    "name": "Companion identity",
    "role": "companion",
    "sourceSystemId": 20,
    "sourceComponentId": 191,
    "heartbeatType": "MAV_TYPE_ONBOARD_CONTROLLER",
    "heartbeatAutopilot": "MAV_AUTOPILOT_INVALID",
    "heartbeatIntervalMs": 1000
  },
  {
    "id": "sitl39-vehicle",
    "type": "mavlink-vehicle",
    "name": "Vehicle profile",
    "vehicleFamily": "copter",
    "firmware": "ardupilot",
    "dialect": "ardupilotmega",
    "defaultTargetSystem": 20,
    "defaultTargetComponent": 1,
    "paramDefsUrl": "",
    "dialectRevision": "seed",
    "additionalDialects": ""
  },
  {
    "id": "sitl39-connection",
    "type": "mavlink-connection",
    "name": "UDP companion 20",
    "mode": "udp",
    "bindHost": "0.0.0.0",
    "bindPort": 14540,
    "remoteHost": "127.0.0.1",
    "remotePort": 14541,
    "vehicle": "sitl39-vehicle",
    "localIdentity": "sitl39-identity",
    "additionalIdentities": [],
    "signOutbound": false,
    "requireSigned": false,
    "acceptInvalid": false,
    "linkId": 0,
    "staleMs": "5000",
    "expireMs": "15000",
    "disabled": false,
    "broadcastHost": "",
    "broadcastPort": "",
    "serialPath": "",
    "baudRate": "57600"
  },
  {
