    "type": "inject",
    "z": "sitl39-tab",
    "name": "Assert ok (5 s lease)",
    "props": [
      {
        "p": "payload",
        "v": "{\"health\":\"ok\"}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 160,
    "wires": [
      [
        "sitl39-health"
      ]
    ]
  },
  {
