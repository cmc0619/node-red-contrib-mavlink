  {
    "id": "sitl44-prep-upload",
    "type": "function",
    "z": "sitl44-tab",
    "name": "Prep FTP probe upload",
    "func": "const body = Buffer.from('nrc-system-ops ' + new Date().toISOString() + '\\n');\nmsg.payload = body;\nmsg.path = '/nrc-system-ops.txt';\nmsg._probeBody = body;\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 640,
    "y": 140,
    "wires": [
