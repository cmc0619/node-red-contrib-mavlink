[
  {
    "id": "sitl44-tab",
    "type": "tab",
    "label": "SITL 44 System ops",
    "disabled": false,
    "info": "Exercise mavlink-system against ArduPilot sysid 1: list onboard logs, MAVFTP upload/download round-trip, then system backup (parameters + fence + rally + files). Partial backup is a valid outcome when a section cannot transfer.",
    "env": []
  },
  {
    "id": "sitl44-comment",
    "type": "comment",
    "z": "sitl44-tab",
    "name": "System: logs → FTP round-trip → backup",
    "info": "One inject chains three System services on AP sysid 1 (14550→14551):\n1. Logs → List — LOG_REQUEST_LIST settles succeeded (empty list is fine on a cold SITL).\n2. Files → Upload a probe Buffer to /nrc-system-ops.txt, then Download and assert byte-identical payload.\n3. Backup/Restore → Backup — parameters/fence/rally run first; the files root is /__nrc_no_such__ so that section fails fast (no @SYS walk). A partial capture with parameters present is a valid PASS.\n\nStatus debugs drop progress so the suite scrape stays on terminal records.\n\nMatches sitl/measure-system-ops.js engines through the palette node.",
    "x": 300,
    "y": 40,
    "wires": []
  },
  {
    "type": "mavlink-local-identity",
    "name": "GCS identity",
    "role": "gcs",
    "sourceSystemId": 255,
    "sourceComponentId": 190,
    "heartbeatType": "MAV_TYPE_GCS",
    "heartbeatAutopilot": "MAV_AUTOPILOT_INVALID",
    "heartbeatIntervalMs": 1000,
    "id": "sitl44-identity"
  },
