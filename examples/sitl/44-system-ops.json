  {
    "type": "mavlink-system",
    "name": "Download probe file",
    "connection": "sitl44-connection",
    "identity": "",
    "service": "files",
    "operation": "download",
    "logId": "",
    "path": "/nrc-system-ops.txt",
    "sections": [
      "parameters",
      "fence",
      "rally",
      "files"
    ],
    "paramEncoding": "auto",
    "targetSystem": 1,
    "targetComponent": 1,
