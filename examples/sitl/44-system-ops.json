  {
    "id": "sitl44-assert-roundtrip",
    "type": "function",
    "z": "sitl44-tab",
    "name": "Assert FTP round-trip",
    "func": "const expected = msg._probeBody;\nconst got = msg.payload;\nconst ok = Buffer.isBuffer(expected) && Buffer.isBuffer(got) && Buffer.compare(got, expected) === 0;\nconst assert = {\n  payload: {\n    result: ok ? 'succeeded' : 'failed',\n    detail: ok\n      ? ('ftp round-trip ' + got.length + ' bytes')\n      : ('ftp mismatch expected=' + (expected && expected.length) + ' got=' + (got && got.length)),\n  },\n};\ndelete msg.path;\nmsg.payload = {};\nreturn [assert, msg];",
    "outputs": 2,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1600,
    "y": 100,
    "wires": [
      [
        "sitl44-ftp-roundtrip-assert"
      ],
      [
        "sitl44-backup"
      ]
    ]
  },
