    "id": "sitl12-tab",
    "type": "tab",
    "label": "SITL 12 Signing",
    "disabled": false,
    "info": "Signing bring-up template: sign-outbound + require-signed on the primary connection, listen-only require-signed on a companion link. Dry-run procedure in tab comment — live verification is version- and setup-dependent.",
