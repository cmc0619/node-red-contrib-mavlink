[
  {
    "id": "ex20-tab",
    "type": "tab",
    "label": "20 Companion origination",
    "disabled": false,
    "info": "Node-RED as onboard companion sharing vehicle sysid 1, compid 191.",
    "env": []
  },
  {
    "id": "ex20-comment",
    "type": "comment",
    "z": "ex20-tab",
    "name": "Companion origination",
    "info": "Companion role: MAV_TYPE_ONBOARD_CONTROLLER, autopilot INVALID. A companion sharing sysid is normal MAVLink; the peer table shows two components under sysid 1. Bind 14550→14551.",
