    "bindHost": "127.0.0.1",
    "bindPort": 14550,
    "remoteHost": "127.0.0.1",
    "remotePort": 14551,
    "vehicle": "ex20-vehicle",
    "localIdentity": "ex20-identity",
    "additionalIdentities": [],
    "signOutbound": false,
